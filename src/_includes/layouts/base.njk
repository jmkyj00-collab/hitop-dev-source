<!DOCTYPE html>
<html lang="{{ page | pageLang }}" data-founded-year="{{ site.foundedYear }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title | t }} | {{ site.brand }}{% else %}{{ site.name | t }}{% if (page | pageLang) == "ko" %} ({{ site.brand }}){% endif %} | {{ "교량이음장치 · 논슬립 · 목재덱 전문기업" | t }}{% endif %}</title>
  <meta name="description" content="{{ (description or site.description) | t }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap">
  <style>.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;line-height:1;}</style>
</head>
<body class="{{ bodyClass or 'bg-white text-ink' }}">

  {% include "partials/nav.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>

{% set footerLang = page | pageLang %}
<footer class="relative border-t border-line bg-section text-on-section-variant">
  <div class="container-hi">

    <!-- 상단: 브랜드 + 고객센터 -->
    <div class="flex flex-col justify-between gap-8 border-b border-ink/10 py-14 md:flex-row md:items-end">
      <div>
        <img src="{{ '/images/brand/logo.png' | url }}" alt="{{ site.name | t }}" class="h-9 w-auto object-contain">
        <p class="mt-5 max-w-md text-sm leading-relaxed">
          {{ "교량이음장치 · 논슬립 · 목재덱 전문 제조기업.<br>직접 생산부터 사후관리까지 책임집니다." | t | safe }}
        </p>
      </div>
      <div class="md:text-right">
        <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.25em] text-secondary/80">Customer Center</p>
        <a href="tel:{{ site.contact.tel }}" class="mt-2 block font-display text-3xl font-extrabold text-ink transition-colors hover:text-accent">{{ site.contact.tel }}</a>
        <p class="mt-1.5 text-xs">{{ "평일 09:00 – 18:00 (주말/공휴일 휴무)" | t }} · {{ site.contact.email }}</p>
      </div>
    </div>

    <!-- 중단: 회사·공장 정보 + 링크
         모바일: 회사 / 공장 / (제품 | 바로가기)  ·  sm~lg: (회사 | 공장) / (제품 | 바로가기)  ·  lg 이상: 한 줄 4칸 -->
    <div class="grid grid-cols-2 gap-10 py-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)_auto_auto] lg:gap-x-12">
      <div class="col-span-2 sm:col-span-1">
        <h5 class="mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.25em] text-secondary/80">Company</h5>
        <p class="text-sm leading-relaxed">
          {{ site.contact.addressEn if footerLang == "en" else site.contact.address }}<br>
          {{ "대표" | t }}: {{ site.ceo | t }} · {{ "사업자번호" | t }}: {{ site.bizRegNo }}<br>
          Tel: {{ site.contact.tel }} · Fax: {{ site.contact.fax }}
        </p>
        <p class="mt-4 font-display text-xs uppercase tracking-wider text-secondary/70">{% for c in site.certs %}{{ c | t }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      </div>

      <div class="col-span-2 sm:col-span-1">
        <h5 class="mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.25em] text-secondary/80">Factory</h5>
        <p class="text-sm leading-relaxed">
          {{ site.branch.addressEn if footerLang == "en" else site.branch.address }}<br>
          Tel: {{ site.branch.tel }}
        </p>
      </div>

      <div>
        <h5 class="mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.25em] text-secondary/80">Products</h5>
        <ul class="space-y-2.5 text-sm">
          <li><a href="{{ '/products-bridge.html' | lurl }}" class="transition-colors hover:text-primary">{{ "교량이음장치" | t }}</a></li>
          <li><a href="{{ '/products-nonslip.html' | lurl }}" class="transition-colors hover:text-primary">{{ "논슬립" | t }}</a></li>
          <li><a href="{{ '/products-deck.html' | lurl }}" class="transition-colors hover:text-primary">{{ "목재덱" | t }}</a></li>
        </ul>
      </div>

      <div>
        <h5 class="mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.25em] text-secondary/80">Quick Links</h5>
        <ul class="space-y-2.5 text-sm">
          <li><a href="{{ '/about/' | lurl }}" class="transition-colors hover:text-primary">{{ "회사소개" | t }}</a></li>
          <li><a href="{{ '/delivery.html' | lurl }}" class="transition-colors hover:text-primary">{{ "납품실적" | t }}</a></li>
          <li><a href="{{ '/about/#location' | lurl }}" class="transition-colors hover:text-primary">{{ "문의하기" | t }}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- 하단 바 -->
  <div class="border-t border-ink/10">
    <div class="container-hi flex flex-col gap-1.5 py-6 text-xs text-secondary/80 sm:flex-row sm:items-center sm:justify-between">
      <span>© {{ years.current }} {% if footerLang == "en" %}{{ site.nameEn }}{% else %}{{ site.name }} ({{ site.nameEn }}).{% endif %} All rights reserved.</span>
      <span class="font-display tracking-wide">{{ site.tagline }}</span>
    </div>
  </div>
</footer>

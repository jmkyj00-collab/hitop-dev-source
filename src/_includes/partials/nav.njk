<header class="navbar" data-navbar>
  <div class="container-hi flex h-full items-center justify-between">

    <!-- 로고 -->
    <a href="{{ '/' | url }}" class="flex items-center" aria-label="{{ site.name }} 홈">
      <img src="{{ '/images/brand/logo.png' | url }}" alt="{{ site.name }}" class="navbar-logo-img">
    </a>

    <!-- 데스크톱·태블릿 메뉴 -->
    <nav class="hidden items-center gap-10 md:flex lg:gap-12" aria-label="주 메뉴">
      {% for item in site.nav %}
        {% if item.children %}
          {% set parentHref = item.url if item.url == "#" else item.url | url %}
          <div class="group relative">
            <a href="{{ parentHref }}" class="navbar-link flex items-center gap-1">
              {{ item.label }}
              <span class="material-symbols-outlined text-base" aria-hidden="true">expand_more</span>
            </a>
            <div class="nav-dropdown">
              {% for child in item.children %}
                <a href="{{ child.url | url }}">{{ child.label }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ item.url | url }}" class="navbar-link {% if page.url == item.url %}is-active{% endif %}">{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- 우측 -->
    <div class="flex items-center gap-5">
      <a href="{{ '/about/#location' | url }}" class="btn-accent hidden !px-5 !py-2.5 md:inline-flex">문의하기</a>
      <button class="text-ink md:hidden" data-nav-toggle
              aria-label="메뉴 열기" aria-controls="mobile-nav" aria-expanded="false">
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</header>

<!-- 모바일 메뉴 패널 -->
<div id="mobile-nav" class="fixed inset-0 z-40 hidden bg-white pt-20 md:hidden" data-mobile-nav>
  <nav class="flex h-full flex-col items-center justify-center gap-6 text-lg font-bold text-ink" aria-label="모바일 메뉴">
    {% for item in site.nav %}
      {% if item.children %}
        <span class="font-display text-xs font-bold uppercase tracking-[0.25em] text-secondary/70">{{ item.label }}</span>
        {% for child in item.children %}
          <a href="{{ child.url | url }}" class="transition-colors hover:text-accent">{{ child.label }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ item.url | url }}" class="transition-colors hover:text-accent">{{ item.label }}</a>
      {% endif %}
    {% endfor %}
    <a href="{{ '/about/#location' | url }}" class="btn-accent mt-2">문의하기</a>
  </nav>
</div>

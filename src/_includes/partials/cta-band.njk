{# 사용법: include 전에 ctaTitle / ctaDesc / ctaSecondary({ label, url }) 를 set #}
<section class="container-hi pb-20 lg:pb-28">
  <div class="overflow-hidden rounded-2xl bg-gradient-to-r from-primary via-[#8e101c] to-accent">
    <div class="flex flex-col items-start justify-between gap-8 p-9 sm:p-12 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-2xl font-extrabold text-white sm:text-3xl">{{ ctaTitle }}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75 sm:text-base">{{ ctaDesc }}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href="tel:{{ site.contact.tel }}" class="font-display text-2xl font-extrabold text-white transition-opacity hover:opacity-80">{{ site.contact.tel }}</a>
        <a href="{{ '/about/#location' | url }}" class="btn-light">문의하기</a>
        {% if ctaSecondary %}
          <a href="{{ ctaSecondary.url | url }}" class="btn-outline-white">{{ ctaSecondary.label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

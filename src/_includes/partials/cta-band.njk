{# 사용법: include 전에 ctaTitle / ctaDesc / ctaSecondary({ label, url }) 를 set — 국문으로 쓰면 영문 페이지에서 자동 번역 #}
<section class="container-hi pb-20 lg:pb-28">
  <div class="overflow-hidden rounded-2xl bg-gradient-to-r from-primary via-[#8e101c] to-accent">
    <div class="flex flex-col items-start justify-between gap-8 p-9 sm:p-12 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-2xl font-extrabold text-white sm:text-3xl">{{ ctaTitle | t }}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75 sm:text-base">{{ ctaDesc | t }}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href="tel:{{ site.contact.tel }}" class="font-display text-2xl font-extrabold text-white transition-opacity hover:opacity-80">{{ site.contact.tel }}</a>
        <a href="{{ '/support/inquiry/' | lurl }}" class="btn-light">{{ "문의하기" | t }}</a>
        {% if ctaSecondary %}
          <a href="{{ ctaSecondary.url | lurl }}" class="btn-outline-white">{{ ctaSecondary.label | t }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

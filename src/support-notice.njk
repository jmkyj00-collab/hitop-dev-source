---
layout: layouts/base.njk
pagination:
  data: locales
  size: 1
  alias: lang
permalink: "{{ '' if lang == 'ko' else 'en/' }}support/notice/index.html"
title: 공지사항
description: 주식회사 하이탑의 공지사항과 소식을 안내합니다.
bodyClass: bg-surface text-ink
---

{#
  공지 등록: src/_data/notices.json 배열 맨 앞에 추가 (최신순으로 표시)
  { "date": "2026-10-24", "title": "제목", "body": ["첫 문단", "둘째 문단"],
    "titleEn": "영문 제목(선택)", "bodyEn": ["영문 본문(선택)"] }
  영문 필드가 없으면 영문 페이지에도 국문 제목·본문이 표시된다.
#}
{% set notices = notices | sort(true, false, "date") %}

<section class="relative mt-20 h-[36vh] min-h-[280px] max-h-[380px] overflow-hidden bg-night">
  <img src="{{ '/images/hero/about-hero.webp' | lurl }}" alt="{{ '교량 구조와 기반시설을 표현한 이미지' | t }}"
       class="absolute inset-0 h-full w-full object-cover object-[center_54%]" width="1672" height="941" fetchpriority="high">
  <div class="absolute inset-0 bg-night/45"></div>
  <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-night/75 to-transparent"></div>

  <div class="container-hi relative z-10 flex h-full flex-col justify-end pb-9 text-white sm:pb-11">
    <nav aria-label="{{ '브레드크럼' | t }}" class="mb-5 flex items-center gap-1.5 text-sm text-white/60">
      <a href="{{ '/' | lurl }}" class="transition-colors hover:text-white">{{ "홈" | t }}</a>
      <span class="material-symbols-outlined text-base" aria-hidden="true">chevron_right</span>
      <span>{{ "고객지원" | t }}</span>
      <span class="material-symbols-outlined text-base" aria-hidden="true">chevron_right</span>
      <span aria-current="page" class="text-white/90">{{ "공지사항" | t }}</span>
    </nav>
    <span class="eyebrow-line !text-white/60">Notice</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white [text-shadow:0_2px_18px_rgba(11,14,19,0.45)] sm:text-4xl">{{ "공지사항" | t }}</h1>
  </div>
</section>

<section class="section container-hi">
  <div class="grid items-end gap-7 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <span class="eyebrow-line">News &amp; Notice</span>
      <h2 class="mt-4 text-3xl font-extrabold leading-snug text-ink sm:text-4xl">{{ "하이탑 소식" | t }}</h2>
    </div>
    <p class="border-t border-ink/15 pt-5 leading-relaxed text-secondary lg:col-span-5">
      {{ "제품·납품 관련 안내와 회사 소식을 알려드립니다." | t }}
    </p>
  </div>

  <div class="notice-list mt-12 border-t border-ink/25">
    {% for n in notices %}
      {% set nTitle = n.titleEn if (lang == "en" and n.titleEn) else n.title %}
      {% set nBody = n.bodyEn if (lang == "en" and n.bodyEn) else n.body %}
      <details class="notice-item group border-b border-line" {% if loop.first %}open{% endif %}>
        <summary class="flex cursor-pointer list-none items-center gap-5 py-6">
          <span class="w-10 shrink-0 font-display text-xs font-bold tracking-[0.16em] text-ink/25">{% if loop.revindex < 10 %}0{% endif %}{{ loop.revindex }}</span>
          <h3 class="min-w-0 flex-1 text-[1.02rem] font-bold leading-relaxed text-ink">{{ nTitle }}</h3>
          <time datetime="{{ n.date }}" class="hidden shrink-0 font-display text-xs font-semibold tracking-wide text-secondary sm:block">{{ n.date | replace("-", ".") }}</time>
          <span class="material-symbols-outlined shrink-0 text-secondary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">expand_more</span>
        </summary>
        <div class="space-y-4 pb-8 pl-15 pr-10 text-sm leading-relaxed text-ink/80">
          <time datetime="{{ n.date }}" class="block font-display text-xs text-secondary sm:hidden">{{ n.date | replace("-", ".") }}</time>
          {% if nBody is string %}<p>{{ nBody }}</p>{% else %}{% for para in nBody %}<p>{{ para }}</p>{% endfor %}{% endif %}
        </div>
      </details>
    {% else %}
      <div class="border-b border-line py-20 text-center">
        <span class="material-symbols-outlined text-3xl text-secondary/50" aria-hidden="true">campaign</span>
        <p class="mt-3 text-sm font-bold text-ink">{{ "등록된 공지사항이 없습니다." | t }}</p>
        <p class="mt-1 text-xs text-secondary">{{ "궁금하신 사항은 온라인문의 또는 고객센터로 연락해 주세요." | t }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% set ctaTitle = "궁금하신 점이 있으신가요?" %}
{% set ctaDesc = "제품과 납품에 관한 문의를 남겨주시면 담당자가 확인 후 연락드립니다." %}
{% set ctaSecondary = { label: "납품실적 보기", url: "/delivery.html" } %}
{% include "partials/cta-band.njk" %}
